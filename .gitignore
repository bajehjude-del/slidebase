# ─────────────────────────────────────────────────────────────
# Slidebase — .gitignore
# ─────────────────────────────────────────────────────────────

# ── OS & Editor ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ─────────────────────────────────────
.next/
out/

# ── Next.js cache ────────────────────────────────────────────
.swc/

# ── Auto-generated Next.js types ─────────────────────────────
next-env.d.ts

# ── Prisma ───────────────────────────────────────────────────
prisma/generated/

# ── TypeScript incremental build cache ───────────────────────
*.tsbuildinfo

# ── Build Outputs ────────────────────────────────────────────
dist/
build/

# ── Testing / Coverage ───────────────────────────────────────
coverage/
.nyc_output/

# ── Vercel deployment ────────────────────────────────────────
.vercel

# ── Environment Variables ────────────────────────────────────
.env
.env.*
!.env.example